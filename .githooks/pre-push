#!/bin/sh
# Pre-push gate: `bun run check` (typecheck + the full suite) inside the
# devcontainer, never on the host — see CLAUDE.md's Conventions. DATABASE_URL
# is already in the container's environment, so the DB-backed suites run
# instead of skipping silently.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Needs the container up:
#   docker compose -f .devcontainer/docker-compose.yml up -d
#
# MSYS_NO_PATHCONV=1 stops Git Bash rewriting /workspace into a Windows path
# before Docker sees it.
set -e

COMPOSE="docker compose -f .devcontainer/docker-compose.yml"

if [ -z "$($COMPOSE ps -q app 2>/dev/null)" ]; then
  echo "pre-push: devcontainer is not running. Start it with:" >&2
  echo "  $COMPOSE up -d" >&2
  echo "To push without the check, pass --no-verify." >&2
  exit 1
fi

MSYS_NO_PATHCONV=1 exec $COMPOSE exec -T -w /workspace app bun run check
