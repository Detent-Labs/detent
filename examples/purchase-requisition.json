          "timers": [
            {
              "id": "timer_7a3d9e15-0001-4a1c-8e2f-000000000001",
              "description": "Reminder when the manager has not decided after 3 days.",
              "duration": "P3D",
              "onFire": {
                "actions": [
                  {
                    "id": "action_4b8c2f60-0001-4a1c-8e2f-000000000001",
                    "type": "notification.email",
                    "config": {
                      "to": ["manager@example.com"],
                      "subject": "Purchase requisition waiting for your approval",
                      "body": "A purchase requisition has waited three days for your decision."
                    },
                    "execution": "async",
                    "retry": {
                      "maxAttempts": 3,
                      "backoff": "exponential",
                      "baseDelay": "PT10S"
                    }
                  }
                ]
              }
            },
            {
              "id": "timer_7a3d9e15-0002-4a1c-8e2f-000000000002",
              "description": "After 7 days the manager step is skipped and finance decides. A timer-forced transition bypasses the target path's guard.",
              "duration": "P7D",
              "onFire": {
                "targetPath": "path_5e1b7c93-0006-4a1c-8e2f-000000000006"
              }
            }
          ],
          "paths": [
            {
              "id": "path_5e1b7c93-0003-4a1c-8e2f-000000000003",
              "key": "approve",
              "label": "Approve",
