  "definition": {
    "key": "purchase_requisition",
    "label": {
      "en": "Purchase Requisition"
    },
    "description": {
      "en": "Requisition to paid invoice: capture, manager approval, amount-based finance approval, PO issue against the ERP, goods receipt with a quantity check, and invoice matching. Two routing steps carry the automatic decisions; the PO step is a wait-state whose paths branch on what the ERP wrote back."
    },
    "baseLocale": "en",
    "contract": {
      "inputFields": [
        "field_9c7e5b31-0001-4a1c-8e2f-000000000001",
        "field_9c7e5b31-0002-4a1c-8e2f-000000000002",
        "field_9c7e5b31-0004-4a1c-8e2f-000000000004",
        "field_9c7e5b31-0005-4a1c-8e2f-000000000005",
        "field_9c7e5b31-0006-4a1c-8e2f-000000000006",
