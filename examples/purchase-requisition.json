            },
            {
              "id": "path_5e1b7c93-0006-4a1c-8e2f-000000000006",
              "key": "escalate",
              "label": "Escalate to finance",
              "to": "step_2d6f8a04-0004-4a1c-8e2f-000000000004",
              "trigger": "manual"
            }
          ]
        },
        {
          "id": "step_2d6f8a04-0003-4a1c-8e2f-000000000003",
          "key": "approval_routing",
          "label": {
            "en": "Route by Amount"
          },
          "description": {
            "en": "No form and no assignee: the instance passes straight through. Anything at or above 10000 needs a second signature from finance; everything else goes to the PO."
          },
          "type": "task",
          "paths": [
            {
              "id": "path_5e1b7c93-0007-4a1c-8e2f-000000000007",
              "key": "needs-finance",
              "label": "Needs finance approval",
              "to": "step_2d6f8a04-0004-4a1c-8e2f-000000000004",
              "trigger": "automatic",
              "priority": 1,
              "guard": {
                "lang": "cel",
                "src": "data.quantity * data.unit_price >= 10000.0"
              }
            },
            {
              "id": "path_5e1b7c93-0008-4a1c-8e2f-000000000008",
              "key": "under-threshold",
              "label": "Under threshold",
              "to": "step_2d6f8a04-0005-4a1c-8e2f-000000000005",
              "trigger": "automatic",
              "priority": 2
            }
          ]
        },
