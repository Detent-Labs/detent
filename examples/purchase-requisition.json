        {
          "id": "step_2d6f8a04-0005-4a1c-8e2f-000000000005",
          "key": "issue_po",
          "label": {
            "en": "Issue Purchase Order"
          },
          "description": {
            "en": "Wait-state. onEntry posts the order to the ERP; the response writes po_number and po_status back into the payload. Two guarded automatic paths and no default: no match means wait, bounded by the 1-day timer. The devcontainer's webhook sink echoes the request body, so config.body is what comes back."
          },
          "type": "task",
          "onEntry": [
            {
              "id": "action_4b8c2f60-0003-4a1c-8e2f-000000000003",
              "type": "http.request",
              "config": {
                "url": "http://localhost:8080/hooks/purchase-order",
                "method": "POST",
                "body": {
                  "po_number": "PO-2026-000123",
                  "status": "issued"
                }
              },
              "output": {
                "field_9c7e5b31-0016-4a1c-8e2f-000000000016": {
                  "lang": "cel",
                  "src": "result.body.po_number"
                },
                "field_9c7e5b31-0017-4a1c-8e2f-000000000017": {
                  "lang": "cel",
                  "src": "result.body.status"
                }
              },
              "execution": "async",
              "idempotencyKey": null,
              "retry": {
                "maxAttempts": 5,
                "backoff": "exponential",
                "baseDelay": "PT30S"
              },
              "timeout": "PT30S"
            }
          ],
          "onCancel": [
            {
              "id": "action_4b8c2f60-0006-4a1c-8e2f-000000000006",
              "type": "http.request",
              "config": {
                "url": "http://localhost:8080/hooks/purchase-order-cancelled",
                "method": "POST"
              },
              "execution": "async",
              "idempotencyKey": null,
              "retry": {
                "maxAttempts": 3,
                "backoff": "exponential",
                "baseDelay": "PT10S"
              },
              "timeout": "PT10S"
            }
          ],
          "timers": [
            {
              "id": "timer_7a3d9e15-0004-4a1c-8e2f-000000000004",
              "description": "Escape hatch: the ERP answered neither issued nor failed within a day.",
              "duration": "P1D",
              "onFire": {
                "targetPath": "path_5e1b7c93-0012-4a1c-8e2f-000000000012"
              }
            }
          ],
          "paths": [
            {
              "id": "path_5e1b7c93-0011-4a1c-8e2f-000000000011",
