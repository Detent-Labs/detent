  "definition": {
    "key": "employee_onboarding",
    "label": {
      "en": "Employee Onboarding"
    },
    "description": {
      "en": "`instance-query-data-source`'s worked example: the device field reads Laptop Inventory's own shelf-step instances, offers the picked device's id as the field's value, and its columnMapping copies the device's serial number onto this instance. See docs/decisions.md's \"Aggregated data source\" entry and examples/laptop-inventory.json."
    },
    "baseLocale": "en",
    "fields": [
      {
        "id": "field_4d7f9b30-0001-4a1c-8e2f-000000000001",
        "key": "employee_name",
        "label": {
          "en": "Employee Name"
        },
        "type": "string",
        "validation": {
          "minLength": 2,
          "maxLength": 100
        }
      },
      {
        "id": "field_4d7f9b30-0002-4a1c-8e2f-000000000002",
        "key": "assigned_device",
        "label": {
          "en": "Assigned Device"
        },
        "description": {
          "en": "Offers every Laptop Inventory instance standing on its shelf step. The option value is that instance's own id, never its asset tag — renaming a device afterward leaves this reference intact."
        },
        "type": "string",
        "dataSource": "ds_2f6a8c40-0001-4a1c-8e2f-000000000001",
        "columnMapping": {
          "serial": "field_4d7f9b30-0003-4a1c-8e2f-000000000003"
        }
      },
      {
        "id": "field_4d7f9b30-0003-4a1c-8e2f-000000000003",
        "key": "device_serial",
        "label": {
          "en": "Device Serial Number"
        },
        "description": {
          "en": "Written by assigned_device's columnMapping. Read-only everywhere a participant sees it."
        },
        "type": "string"
      }
    ],
    "dataSources": [
      {
        "id": "ds_2f6a8c40-0001-4a1c-8e2f-000000000001",
        "key": "available_devices",
        "type": "instance.query",
        "config": {
          "processId": "proc_laptop_inventory",
          "stepIds": ["step_3b5d7f10-0001-4a1c-8e2f-000000000001"],
          "labelFieldId": "field_8a1c2e60-0001-4a1c-8e2f-000000000001",
          "attributes": {
            "serial": "field_8a1c2e60-0002-4a1c-8e2f-000000000002"
          }
        }
      }
    ],
    "workflow": {
