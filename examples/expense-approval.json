{
  "processId": "proc_3f8a1c2e-9b4d-4e7a-a1c8-2e5f7b9d0a13",
  "version": 1,
  "definitionHash": "16da012aabc01f1420f766861186249586045e9562c5d12dbb9b10cf09004ee7",
  "status": "published",
  "publishedAt": "2026-07-18T09:00:00Z",
  "definition": {
    "key": "expense_approval",
    "label": {
      "en": "Expense Approval"
    },
    "description": {
      "en": "Simple approval: Capture, Review, Book. The Book step is a wait-state whose automatic paths branch on the result of the booking action."
    },
    "baseLocale": "en",
    "contract": {
      "inputFields": [
        "field_1a2b3c4d-0001-4a1c-8e2f-000000000001",
        "field_1a2b3c4d-0002-4a1c-8e2f-000000000002"
      ],
      "outputFields": [
        "field_1a2b3c4d-0004-4a1c-8e2f-000000000004"
      ],
      "outcomes": [
        "booked",
        "rejected"
      ]
    },
    "fields": [
      {
        "id": "field_1a2b3c4d-0001-4a1c-8e2f-000000000001",
        "key": "amount",
        "label": {
          "en": "Amount"
        },
        "type": "number",
        "validation": {
          "min": 0
        }
      },
      {
        "id": "field_1a2b3c4d-0002-4a1c-8e2f-000000000002",
        "key": "reason",
        "label": {
          "en": "Reason"
        },
        "type": "string",
        "validation": {
          "maxLength": 500
        }
      },
      {
        "id": "field_1a2b3c4d-0003-4a1c-8e2f-000000000003",
        "key": "review_note",
        "label": {
          "en": "Review Note"
        },
        "type": "string",
        "validation": {
          "maxLength": 500
        }
      },
      {
        "id": "field_1a2b3c4d-0004-4a1c-8e2f-000000000004",
        "key": "booking_status",
        "label": {
          "en": "Booking Status"
        },
        "description": {
          "en": "Internal status, set by the booking action (write-back into the payload). Not part of any editable view."
        },
        "type": "select",
        "options": [
          {
            "value": "pending",
            "label": {
              "en": "Pending"
            }
          },
          {
            "value": "booked",
            "label": {
              "en": "Booked"
            }
          },
          {
            "value": "failed",
            "label": {
              "en": "Failed"
            }
          }
        ],
        "default": "pending"
      }
    ],
    "dataSources": [],
    "workflow": {
      "initialStep": "step_aaaa1111-0001-4a1c-8e2f-000000000001",
      "steps": [
        {
          "id": "step_aaaa1111-0001-4a1c-8e2f-000000000001",
          "key": "capture",
          "label": {
            "en": "Capture"
          },
          "type": "task",
          "assignment": {
            "strategy": {
              "type": "static",
              "config": {
                "candidates": ["employee"]
              }
            }
          },
          "view": {
            "fields": [
              {
                "ref": "field_1a2b3c4d-0001-4a1c-8e2f-000000000001",
                "required": true
              },
              {
                "ref": "field_1a2b3c4d-0002-4a1c-8e2f-000000000002",
                "required": true
              }
            ]
          },
          "paths": [
            {
              "id": "path_bbbb2222-0001-4a1c-8e2f-000000000001",
              "key": "submit",
              "label": "Submit",
              "to": "step_aaaa1111-0002-4a1c-8e2f-000000000002",
              "trigger": "manual"
            }
          ]
        },
        {
          "id": "step_aaaa1111-0002-4a1c-8e2f-000000000002",
          "key": "review",
          "label": {
            "en": "Review"
          },
          "type": "task",
          "assignment": {
            "strategy": {
              "type": "static",
              "config": {
                "candidates": ["finance-approver"]
              }
            }
          },
          "view": {
            "fields": [
              {
                "ref": "field_1a2b3c4d-0001-4a1c-8e2f-000000000001",
                "readonly": true
              },
              {
                "ref": "field_1a2b3c4d-0002-4a1c-8e2f-000000000002",
                "readonly": true
              },
              {
                "ref": "field_1a2b3c4d-0003-4a1c-8e2f-000000000003",
                "required": true
              }
            ]
          },
          "timers": [
            {
              "id": "timer_dddd4444-0001-4a1c-8e2f-000000000001",
              "description": "Reminder when not reviewed after 7 days.",
              "duration": "P7D",
              "onFire": {
                "actions": [
                  {
                    "id": "action_eeee5555-0001-4a1c-8e2f-000000000001",
                    "type": "notify.email",
                    "config": {
                      "template": "review-reminder",
                      "toRole": "finance-approver"
                    },
                    "execution": "async",
                    "retry": {
                      "maxAttempts": 3,
                      "backoff": "exponential",
                      "baseDelay": "PT10S"
                    }
                  }
                ]
              }
            }
          ],
          "paths": [
            {
              "id": "path_bbbb2222-0002-4a1c-8e2f-000000000002",
              "key": "approve",
              "label": "Approve",
              "to": "step_aaaa1111-0003-4a1c-8e2f-000000000003",
              "trigger": "manual"
            },
            {
              "id": "path_bbbb2222-0003-4a1c-8e2f-000000000003",
              "key": "reject",
              "label": "Reject",
              "to": "step_aaaa1111-0005-4a1c-8e2f-000000000005",
              "trigger": "manual"
            }
          ]
        },
        {
          "id": "step_aaaa1111-0003-4a1c-8e2f-000000000003",
          "key": "book",
          "label": {
            "en": "Book"
          },
          "type": "task",
          "description": {
            "en": "Wait-state. onEntry triggers the booking (async). Two automatic paths branch on booking_status, which the action writes back."
          },
          "onEntry": [
            {
              "id": "action_eeee5555-0002-4a1c-8e2f-000000000002",
              "type": "accounting.postInvoice",
              "config": {
                "amountField": "field_1a2b3c4d-0001-4a1c-8e2f-000000000001"
              },
              "output": {
                "field_1a2b3c4d-0004-4a1c-8e2f-000000000004": {
                  "lang": "cel",
                  "src": "result.status"
                }
              },
              "execution": "async",
              "idempotencyKey": null,
              "retry": {
                "maxAttempts": 5,
                "backoff": "exponential",
                "baseDelay": "PT30S"
              },
              "timeout": "PT30S"
            }
          ],
          "timers": [
            {
              "id": "timer_dddd4444-0002-4a1c-8e2f-000000000002",
              "description": "SLA escape hatch if the booking is neither booked nor failed after 1 day.",
              "duration": "P1D",
              "onFire": {
                "targetPath": "path_bbbb2222-0005-4a1c-8e2f-000000000005"
              }
            }
          ],
          "paths": [
            {
              "id": "path_bbbb2222-0004-4a1c-8e2f-000000000004",
              "key": "booked",
              "label": "Booked",
              "to": "step_aaaa1111-0004-4a1c-8e2f-000000000004",
              "trigger": "automatic",
              "priority": 1,
              "guard": {
                "lang": "cel",
                "src": "data.booking_status == 'booked'"
              }
            },
            {
              "id": "path_bbbb2222-0005-4a1c-8e2f-000000000005",
              "key": "booking-failed",
              "label": "Booking Failed",
              "to": "step_aaaa1111-0006-4a1c-8e2f-000000000006",
              "trigger": "automatic",
              "priority": 2,
              "guard": {
                "lang": "cel",
                "src": "data.booking_status == 'failed'"
              }
            }
          ]
        },
        {
          "id": "step_aaaa1111-0004-4a1c-8e2f-000000000004",
          "key": "booked",
          "label": {
            "en": "Booked"
          },
          "type": "task",
          "terminal": true,
          "outcome": "booked",
          "view": {
            "fields": [
              {
                "ref": "field_1a2b3c4d-0001-4a1c-8e2f-000000000001",
                "readonly": true
              },
              {
                "ref": "field_1a2b3c4d-0004-4a1c-8e2f-000000000004",
                "readonly": true
              }
            ]
          }
        },
        {
          "id": "step_aaaa1111-0005-4a1c-8e2f-000000000005",
          "key": "rejected",
          "label": {
            "en": "Rejected"
          },
          "type": "task",
          "terminal": true,
          "outcome": "rejected",
          "view": {
            "fields": [
              {
                "ref": "field_1a2b3c4d-0003-4a1c-8e2f-000000000003",
                "readonly": true
              }
            ]
          }
        },
        {
          "id": "step_aaaa1111-0006-4a1c-8e2f-000000000006",
          "key": "booking_error",
          "label": {
            "en": "Booking Error"
          },
          "type": "task",
          "description": {
            "en": "Visible fault state instead of a hidden transaction rollback. A human picks the next action."
          },
          "assignment": {
            "strategy": {
              "type": "static",
              "config": {
                "candidates": ["finance-approver"]
              }
            }
          },
          "view": {
            "fields": [
              {
                "ref": "field_1a2b3c4d-0001-4a1c-8e2f-000000000001",
                "readonly": true
              },
              {
                "ref": "field_1a2b3c4d-0004-4a1c-8e2f-000000000004",
                "readonly": true
              }
            ]
          },
          "paths": [
            {
              "id": "path_bbbb2222-0006-4a1c-8e2f-000000000006",
              "key": "retry-booking",
              "label": "Retry Booking",
              "to": "step_aaaa1111-0003-4a1c-8e2f-000000000003",
              "trigger": "manual"
            }
          ]
        }
      ]
    }
  }
}
