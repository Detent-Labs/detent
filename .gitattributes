# Normalize line endings, avoid CRLF/LF churn between Windows and other OSes
* text=auto eol=lf

# Never diff/merge lockfiles as text
package-lock.json -diff
pnpm-lock.yaml -diff
yarn.lock -diff

# Treat as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
