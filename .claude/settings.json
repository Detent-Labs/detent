{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "codebase-memory-mcp",
            "tool": "index_repository",
            "input": {
              "repo_path": "C:/Users/Roman/AI/SummitBPS",
              "mode": "fast"
            },
            "timeout": 120,
            "statusMessage": "Refreshing codebase memory index..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "codebase-memory-mcp",
            "tool": "index_repository",
            "input": {
              "repo_path": "C:/Users/Roman/AI/SummitBPS",
              "mode": "fast"
            },
            "timeout": 120,
            "statusMessage": "Refreshing codebase memory index..."
          }
        ]
      }
    ]
  }
}
