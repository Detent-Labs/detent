.DS_Store
Thumbs.db

# Claude Code (personal, per-machine)
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/
# Holds an absolute path to a linter outside this repository.
.claude/skills/antislop/

# Local devcontainer overrides (personal, per-machine)
.devcontainer/docker-compose.override.yml
.devcontainer/docker-compose.ports.yml
.devcontainer/.auth-secret
.devcontainer/server.log

# temp files
tmp/

# Regenerated reports (/ponytail-audit, /ponytail-debt)
PONYTAIL-AUDIT.md
PONYTAIL-DEBT.md

# Brainstorming companion mockups (per-session, local)
.superpowers/
# superpowers plans/specs (personal, must not be pushed)
docs/superpowers/

# Impeccable per-machine state. config.json and design.json are shared;
# these two are not: consent is per-machine, and the cache stores absolute
# paths that the no-machine-paths push gate rejects.
.impeccable/config.local.json
.impeccable/hook.cache.json

# Impeccable's installed skill and agent files. Vendored third-party content,
# reinstalled per machine like .claude/skills/antislop/ above. Tracking them
# put 2140 antislop findings across 79 files in front of the prose gate, none
# of it this project's prose to rewrite.
.claude/agents/impeccable-*
.claude/skills/impeccable/
.github/agents/impeccable-*
.github/skills/impeccable/
.github/hooks/impeccable.json
