{
  "name": "workflow-engine",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    "./schema": "./src/schema/definition.ts",
    "./schema/canonical-json": "./src/schema/canonical-json.ts",
    "./schema/strip-compiled": "./src/schema/strip-compiled.ts",
    "./cel/check": "./src/cel/check.ts",
    "./schema/compile": "./src/schema/compile.ts",
    "./engine/registry": "./src/engine/registry.ts",
    "./engine/registry-check": "./src/engine/registry-check.ts",
    "./validate": "./src/validate.ts"
  },
  "scripts": {
    "prepare": "sh scripts/enable-hooks.sh",
    "typecheck:engine": "tsc --noEmit",
    "typecheck": "bun run typecheck:engine && bun run --filter './packages/*' typecheck",
    "build": "bun run --filter './packages/*' build",
    "test": "bun test",
    "test:tz": "TZ=Europe/Zurich bun test packages/web/test/reporting-reportingLogic.test.ts",
    "check": "bun run typecheck && bun run build && bun test && bun run test:tz",
    "serve": "bun run src/http/server.ts",
    "seed": "bun run scripts/seed.ts",
    "openspec:review-check": "bun run scripts/openspec-review-check.ts",
    "openspec:spec-diff": "bun run scripts/openspec-spec-diff.ts",
    "openspec:task-status": "bun run scripts/openspec-task-status.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "8.0.0",
    "jose": "^6.2.4",
    "zod": "4.4.3"
  }
}
